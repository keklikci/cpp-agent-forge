#!/bin/sh

set -eu

program=cpp-agent-forge

usage() {
    cat <<'EOF'
Usage:
  cpp-agent-forge init <target-directory>
  cpp-agent-forge check <target-directory>
  cpp-agent-forge help

Commands:
  init    Generate the CAF files in a target C++ repository.
  check   Validate CAF files in a target C++ repository.
  help    Show this help text.
EOF
}

error() {
    printf '%s: %s\n' "$program" "$1" >&2
    printf '%s\n' "Try '$program help' for usage." >&2
    exit 2
}

require_target() {
    [ "$#" -eq 2 ] || error "$1 requires a target directory"
    [ -n "$2" ] || error "$1 requires a target directory"
}

init_repository() {
    target=$1
    files='AGENTS.md .codex/project.yml .github/workflows/cpp-ci.yml .github/pull_request_template.md docs/agent-workflow.md scripts/validate-cpp.sh'

    mkdir -p "$target"
    cd "$target"

    if [ "${CAF_FORCE-0}" != 1 ]; then
        for file in $files; do
            if [ -e "$file" ]; then
                error "refusing to overwrite $file (set CAF_FORCE=1 to overwrite)"
            fi
        done
    fi

    mkdir -p .codex .github/workflows docs scripts

    cat > AGENTS.md <<'EOF'
# C++ Repository Agent Instructions

This repository follows the C++ Agent Forge workflow.

- Use C++17 and CMake 3.20 or newer.
- Configure and build out of tree; run tests with CTest.
- Treat `src/**`, `include/**`, `tests/**`, and build configuration as owned
  repository paths unless a task explicitly narrows the scope.
- Enable `-Wall -Wextra -Wpedantic` for GCC and Clang.
- Run clang-format on changed C++ files. Use clang-tidy when available.
- Exercise AddressSanitizer and UndefinedBehaviorSanitizer for relevant code.
- Avoid unbounded loops in test paths and document platform-specific behavior.
- Never persist local absolute paths, credentials, tokens, or private data.

Every task must include `task_id`, `pr_title`, `brief`, `allowed_paths`,
`model`, and `reasoning_effort`. Keep the canonical PLAN, IMPLEMENT, and REVIEW
names synchronized with the task metadata.
EOF

    cat > .codex/project.yml <<'EOF'
# Replace placeholders with consumer-repository values.
task_id: replace-with-task-id
pr_number: null
pr_title: "Replace with a short, action-oriented PR title"
brief: "Replace with a one-sentence description of the intended change"
repository: OWNER/REPOSITORY
base_branch: main
branch: codex/task-name
allowed_paths:
  - src/**
  - include/**
  - tests/**
dependencies: []
model: gpt-5.6-terra
reasoning_effort: medium
standard: c++17
cmake_minimum: "3.20"
configure_command: cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug
build_command: cmake --build build --parallel
test_command: ctest --test-dir build --output-on-failure
format_command: clang-format --dry-run --Werror
sanitizer_command: cmake -S . -B build-asan -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS="-fsanitize=address,undefined -fno-omit-frame-pointer"
status: queued
EOF

    cat > .github/workflows/cpp-ci.yml <<'EOF'
name: C++ CI

on:
  push:
  pull_request:

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        compiler: [gcc, clang]
    steps:
      - uses: actions/checkout@v4
      - name: Select compiler
        run: |
          if [ "${{ matrix.compiler }}" = clang ]; then
            echo "CC=clang" >> "$GITHUB_ENV"
            echo "CXX=clang++" >> "$GITHUB_ENV"
          else
            echo "CC=gcc" >> "$GITHUB_ENV"
            echo "CXX=g++" >> "$GITHUB_ENV"
          fi
      - name: Configure
        run: cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug
      - name: Build
        run: cmake --build build --parallel
      - name: Test
        run: ctest --test-dir build --output-on-failure
      - name: Format check
        run: clang-format --dry-run --Werror $(find . -type f \( -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' \))

  sanitizers:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Configure with sanitizers
        run: cmake -S . -B build-asan -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS="-fsanitize=address,undefined -fno-omit-frame-pointer"
      - name: Build
        run: cmake --build build-asan --parallel
      - name: Test
        run: ctest --test-dir build-asan --output-on-failure
EOF

    cat > .github/pull_request_template.md <<'EOF'
## Summary

- PR title: <!-- keep this synchronized with task metadata -->
- Brief: <!-- one sentence -->

## Scope

- Allowed paths:
- Out-of-scope paths:

## Validation

- [ ] CMake configure and build
- [ ] CTest
- [ ] clang-format
- [ ] clang-tidy, when available
- [ ] AddressSanitizer and UndefinedBehaviorSanitizer, when relevant

## Risk and review

- [ ] No absolute user paths, credentials, tokens, or private data added
- [ ] Ownership and synchronization implications documented
- [ ] Platform-specific behavior documented
- [ ] Required reviewers identified
EOF

    cat > docs/agent-workflow.md <<'EOF'
# Agent Workflow

Use one task owner, one branch, one worktree, and one pull request per task.
Keep write agents in isolated worktrees and serialize tasks with overlapping
path ownership.

## Task identity

Record `task_id`, `pr_title`, `brief`, `repository`, `base_branch`, `branch`,
and `allowed_paths`, together with the selected `model` and
`reasoning_effort`.

Use these canonical names:

- `PLAN - <initiative> - <brief>`
- `IMPLEMENT - PR #<number> - <pr-title>`
- `REVIEW - PR #<number> - <pr-title>`

Begin every session with the PR number and title, brief, scope, branch, and
repository. Do not put local absolute paths, usernames, tokens, or private
repository data in names or persisted metadata.

## Execution

The planner produces acceptance criteria, dependencies, owned paths, commands,
and risks. The implementer changes only assigned paths and reports validation.
CI runs the CMake, CTest, formatting, and sanitizer checks. The reviewer reads
the complete diff and CI results, then reports actionable findings. Human
approval is required before merging.
EOF

    cat > scripts/validate-cpp.sh <<'EOF'
#!/bin/sh

set -eu

build_dir=${CAF_BUILD_DIR-build}
cmake -S . -B "$build_dir" -DCMAKE_BUILD_TYPE=Debug
cmake --build "$build_dir" --parallel
ctest --test-dir "$build_dir" --output-on-failure
EOF
    chmod +x scripts/validate-cpp.sh

    for file in $files; do
        printf 'generated %s\n' "$file"
    done
    printf '%s\n' 'Next steps:'
    printf '%s\n' '  1. Replace placeholders in .codex/project.yml.'
    printf '%s\n' '  2. Add project-specific instructions to AGENTS.md.'
    printf '%s\n' '  3. Run cpp-agent-forge check .'
}

check_repository() {
    target=$1
    files='AGENTS.md .codex/project.yml .github/workflows/cpp-ci.yml .github/pull_request_template.md docs/agent-workflow.md scripts/validate-cpp.sh'
    failures=0

    [ -d "$target" ] || error "target directory does not exist: $target"
    cd "$target"

    for file in $files; do
        if [ -f "$file" ]; then
            printf 'present %s\n' "$file"
        else
            printf 'missing %s\n' "$file" >&2
            failures=$((failures + 1))
        fi
    done

    for file in $(find . -type f -name '*.sh' -not -path './.git/*' -print); do
        if sh -n "$file" 2>/dev/null; then
            printf 'shell syntax ok %s\n' "$file"
        else
            printf 'invalid shell syntax %s\n' "$file" >&2
            failures=$((failures + 1))
        fi
    done

    if command -v ruby >/dev/null 2>&1; then
        for file in .codex/project.yml .github/workflows/cpp-ci.yml; do
            if [ -f "$file" ] && ruby -e 'require "yaml"; YAML.load_file(ARGV.fetch(0))' "$file" >/dev/null 2>&1; then
                printf 'yaml syntax ok %s\n' "$file"
            elif [ -f "$file" ]; then
                printf 'invalid yaml %s\n' "$file" >&2
                failures=$((failures + 1))
            fi
        done
    else
        printf '%s\n' 'yaml parser unavailable; skipped YAML syntax validation'
    fi

    project=.codex/project.yml
    for field in task_id pr_title brief allowed_paths model reasoning_effort; do
        if [ ! -f "$project" ]; then
            break
        fi
        if grep -Eq "^${field}:[[:space:]]*[^[:space:]]" "$project"; then
            printf 'task field ok %s\n' "$field"
        elif [ "$field" = allowed_paths ] && grep -Eq '^  -[[:space:]]*[^[:space:]]' "$project"; then
            printf 'task field ok %s\n' "$field"
        else
            printf 'missing or empty task field %s\n' "$field" >&2
            failures=$((failures + 1))
        fi
    done

    if [ -f "$project" ]; then
        for requirement in \
            'model:[[:space:]]*gpt-5\.6-terra' \
            'reasoning_effort:[[:space:]]*medium' \
            'standard:[[:space:]]*c\+\+17' \
            'cmake_minimum:.*3\.20' \
            'configure_command:.*cmake -S' \
            'build_command:.*cmake --build' \
            'test_command:.*ctest' \
            'format_command:.*clang-format' \
            'sanitizer_command:.*fsanitize[=:]address,undefined'; do
            if grep -Eq "^${requirement}" "$project"; then
                :
            else
                printf 'project metadata missing requirement: %s\n' "$requirement" >&2
                failures=$((failures + 1))
            fi
        done
    fi

    privacy_files=$(find . -type f -not -path './.git/*' -not -path './build/*' -not -path './build-*/*' -print)
    privacy_pattern='/(Users|home|private/var|var/folders|tmp)/|[A-Za-z]:[\\/]Users[\\/]|(ghp_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY|sk-[A-Za-z0-9]{16,})'
    if [ -n "$privacy_files" ] && printf '%s\n' "$privacy_files" | xargs grep -I -n -E "$privacy_pattern" >/dev/null 2>&1; then
        printf '%s\n' 'privacy scan failed: absolute user path or likely secret detected' >&2
        failures=$((failures + 1))
    else
        printf '%s\n' 'privacy scan ok'
    fi

    if [ "$failures" -eq 0 ]; then
        printf '%s\n' 'check: OK'
        return 0
    fi
    printf 'check: %s failure(s)\n' "$failures" >&2
    return 1
}

command=${1-help}

case "$command" in
    help|-h|--help)
        [ "$#" -eq 1 ] || error "help does not accept arguments"
        usage
        ;;
    init|check)
        require_target "$command" "${2-}"
        [ "$#" -eq 2 ] || error "$command accepts exactly one target directory"
        if [ "$command" = init ]; then
            init_repository "$2"
        else
            check_repository "$2"
        fi
        ;;
    *)
        error "unknown command: $command"
        ;;
esac
